<% if user_signed_in? %>
  <%= link_to '新しい施設を登録', new_room_path, class: 'btn btn-primary' %>
<% end %>

<table class="table table-bordered mt-3">
  <thead class="thead-light">
    <tr>
      <th>施設画像</th>
      <th>施設名</th>
      <th>紹介文</th>
      <th>宿泊料金（/日）</th>
      <th>作成日</th>
    </tr>
  </thead>
  <tbody>
    <% current_user.rooms.each do |room| %>
      <tr>
        <td>
          <% if room.room_image.attached? %>
            <%= image_tag room.room_image, class: 'room-thumbnail' %>
          <% else %>
            <%= image_tag "default-image.png", class: 'room-thumbnail' %>
          <% end %>
        </td>
        <td><%= link_to room.name, room %></td>
        <td><%= truncate(room.description, length: 50) %></td>
        <td>¥<%= number_with_delimiter(room.price) %></td>
        <td><%= room.created_at.strftime("%Y年%m月%d日") %></td>
      </tr>
    <% end %>
  </tbody>
</table>
