<h2 class="signup-heading">新規登録</h2>

<div class="signup-form-wrapper">
  <%= form_with model: resource, url: registration_path(resource_name), local: true, html: { class: 'signup-form' } do |f| %>
  <%= render "devise/shared/error_messages", resource: resource, class: 'error-messages' %>

  <div class="field">
    <%= f.label :name,"名前", class: "label" %>
    <%= f.text_field :name, class: "input-field" %>
  </div>

  <div class="field">
    <%= f.label :email, "メールアドレス", class: "label" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input-field" %>
  </div>

  <div class="field">
    <%= f.label :password, "パスワード", class: "label" %>
    <% if @minimum_password_length %>
      <em class="password-min-length">(<%= @minimum_password_length %> 文字以上で設定してください。)</em>
    <% end %>
    <%= f.password_field :password, autocomplete: "new-password", class: "input-field" %>
  </div>

  <div class="field">
    <%= f.label :password_confirmation, "パスワード（確認用）", class: "label" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input-field" %>
  </div>

  <div class="actions">
    <%= f.submit "新規登録", class: "submit-button" %>
  </div>
<% end %>
</div>


