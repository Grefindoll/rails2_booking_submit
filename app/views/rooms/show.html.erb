<div class="room-detail-container">
  <h2 class="room-detail-title">施設の詳細</h2>
  
  <div class="room-detail-content">
    <div class="room-image-section">
      <% if @room.room_image.attached? %>
        <%= image_tag @room.room_image, class: "room-main-image" %>
      <% else %>
        <div class="no-image-message">
          <p>画像はありません。デフォルトの画像を表示します。</p>
          <%= image_tag "default-image.png", class: "room-main-image" %>
        </div>
      <% end %>
    </div>

    <div class="room-info-section">
      <h3 class="room-name"><%= @room.name %></h3>
      <p class="room-description"><%= @room.description %></p>
      
      <div class="room-detail-item">
        <span class="detail-label">宿泊料金:</span>
        <span class="detail-value"><%= number_to_currency(@room.price_per_night, unit: "¥", precision: 0) %></span>
      </div>
      
      <div class="room-detail-item">
        <span class="detail-label">住所:</span>
        <span class="detail-value"><%= @room.address %></span>
      </div>

      <div class="action-buttons">
        <%= link_to "予約する", new_room_reservation_path(room_id: @room.id), class: "btn-reserve" %>
        <%= link_to '前のページに戻る', :back, class: "btn-back" %>
      </div>
    </div>
  </div>
</div>